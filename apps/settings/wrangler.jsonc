{
  "name": "snazzy-settings-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "yoppa.cloudflareaccess.com",
    "ACCESS_AUD": "afb03a63baf3d48818f3dde1711f5b6f1fe8d6b96c8663462434cb14e53d0d6f",
    "SETTINGS_ORIGIN": "https://snazzy-settings-staging.clicky-worker.workers.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "services": [
    {
      "binding": "SETTINGS_SERVICE",
      "service": "snazzy-automation-staging",
      "entrypoint": "SettingsService",
    },
  ],
  "env": {
    "production": {
      "name": "snazzy-settings-production",
      "account_id": "1faf55af4ab8b3f083d8aba5bd88f28a",
      "vars": {
        "ACCESS_TEAM_DOMAIN": "snazzybrandname-team.cloudflareaccess.com",
        "ACCESS_AUD": "a960d81476296336f39511232390f51d30bc30fae6868f432564a48ee8c30304",
        "SETTINGS_ORIGIN": "https://snazzy-settings-production.snazzybrandnamedev.workers.dev"
      },
      "services": [
        {
          "binding": "SETTINGS_SERVICE",
          "service": "snazzy-automation-production",
          "entrypoint": "SettingsService"
        }
      ]
    }
  },
}
