{
  "name": "snazzy-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "images": { "binding": "IMAGES" },
  "workflows": [
    {
      "name": "snazzy-import-workflow-local",
      "binding": "IMPORT_WORKFLOW",
      "class_name": "ImportWorkflow"
    },
    {
      "name": "snazzy-publication-workflow-local",
      "binding": "PUBLICATION_WORKFLOW",
      "class_name": "PublicationWorkflow"
    },
    {
      "binding": "LINE_COMMAND_WORKFLOW",
      "name": "snazzy-line-command-local",
      "class_name": "LineCommandWorkflow"
    },
      { "binding": "LINE_MUTATION_FOLLOWUP_WORKFLOW", "name": "snazzy-line-mutation-followup-local", "class_name": "LineMutationFollowupWorkflow" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snazzy-automation-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "snazzy-automation-local-images"
    }
  ],
  "env": {
    "staging": {
      "name": "snazzy-automation-staging",
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "vars": {
        "GOOGLE_OAUTH_CLIENT_ID": "891460059017-fg9acj1nhbtjb133d6vgoj7ljh8ng5n4.apps.googleusercontent.com"
      },
      "triggers": {
        "crons": ["45 22 * * *", "0 23 * * *", "30 23 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snazzy-automation-staging",
          "database_id": "a755745f-c9a9-4015-8f79-08ee6bf9eba0",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "snazzy-automation-staging-images"
        }
      ],
      "images": { "binding": "IMAGES" },
      "workflows": [
        {
          "binding": "IMPORT_WORKFLOW",
          "name": "snazzy-import-staging",
          "class_name": "ImportWorkflow"
        },
        {
          "binding": "PUBLICATION_WORKFLOW",
          "name": "snazzy-publication-staging",
          "class_name": "PublicationWorkflow"
        },
        {
          "binding": "LINE_COMMAND_WORKFLOW",
          "name": "snazzy-line-command-staging",
          "class_name": "LineCommandWorkflow"
        },
      { "binding": "LINE_MUTATION_FOLLOWUP_WORKFLOW", "name": "snazzy-line-mutation-followup-staging", "class_name": "LineMutationFollowupWorkflow" }
      ]
    },
    "production": {
      "name": "snazzy-automation-production",
      "triggers": {
        "crons": ["45 22 * * *", "0 23 * * *", "30 23 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snazzy-automation-production",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "snazzy-automation-production-images"
        }
      ],
      "images": { "binding": "IMAGES" },
      "workflows": [
        {
          "binding": "IMPORT_WORKFLOW",
          "name": "snazzy-import-production",
          "class_name": "ImportWorkflow"
        },
        {
          "binding": "PUBLICATION_WORKFLOW",
          "name": "snazzy-publication-production",
          "class_name": "PublicationWorkflow"
        },
        {
          "binding": "LINE_COMMAND_WORKFLOW",
          "name": "snazzy-line-command-production",
          "class_name": "LineCommandWorkflow"
        },
      { "binding": "LINE_MUTATION_FOLLOWUP_WORKFLOW", "name": "snazzy-line-mutation-followup-production", "class_name": "LineMutationFollowupWorkflow" }
      ]
    }
  }
}
